<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/titleToolBar"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        app:layout_constraintTop_toTopOf="parent">


        <ImageView
            android:id="@+id/movePreviousButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:src="@drawable/arrow_left"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/main_font"
            android:text="공유 올리기"
            android:textColor="@color/app_main"
            android:textSize="23sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleToolBar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/productImageTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/main_font"
                android:text="음식 사진 등록"
                android:textColor="@color/black"
                android:textSize="18sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <HorizontalScrollView
                android:id="@+id/productImageScrollView"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="10dp"
                android:scrollbars="none"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/productImageTextView">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:id="@+id/addProductImageButton"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="22dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/add_product_image_round"
                        android:clipToOutline="true"
                        android:elevation="5dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:src="@drawable/camera" />

                        <TextView
                            android:id="@+id/productImageCountTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/image_count" />

                    </LinearLayout>


                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/productImageRecyclerView"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_toRightOf="@id/addProductImageButton"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </RelativeLayout>


            </HorizontalScrollView>


            <LinearLayout
                android:id="@+id/titleLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="22dp"
                android:background="@drawable/add_product_image_round"
                android:elevation="5dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/productImageScrollView">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:layout_marginTop="18dp"
                    android:fontFamily="@font/main_font"
                    android:text="제목"
                    android:textColor="@color/app_main"
                    android:textSize="20sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/titleEditTextLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="35dp"
                    android:layout_marginEnd="28dp"
                    android:layout_marginBottom="18dp"
                    app:boxBackgroundColor="@color/white"
                    app:counterEnabled="true"
                    app:counterMaxLength="20"
                    app:errorEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/titleEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="상품명"
                        android:textSize="18sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/titleEditTextError"
                    android:layout_marginBottom="10dp"
                    android:layout_marginStart="40dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="빈칸을 입력해주세요."
                    android:textColor="#FD0000"
                    android:textSize="18sp"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="@id/purchasePriceTextView"
                    app:layout_constraintTop_toBottomOf="@id/purchasePriceEditText"
                    tools:visibility="visible" />
            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/purchaseInfoLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="22dp"
                android:background="@drawable/add_product_image_round"
                android:elevation="5dp"
                android:paddingBottom="18dp"
                app:layout_constraintTop_toBottomOf="@id/titleLinearLayout">

                <TextView
                    android:id="@+id/purchasePriceTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:layout_marginTop="18dp"
                    android:fontFamily="@font/main_font"
                    android:text="구입 가격"
                    android:textColor="@color/app_main"
                    android:textSize="20sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/purchasingVolumeTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginEnd="50dp"
                    android:fontFamily="@font/main_font"
                    android:text="구입 수량"
                    android:textColor="@color/app_main"
                    android:textSize="20sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <EditText
                    android:id="@+id/purchasePriceEditText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:inputType="number"
                    app:layout_constraintEnd_toStartOf="@id/baseLineTextView"
                    app:layout_constraintStart_toStartOf="@id/purchasePriceTextView"
                    app:layout_constraintTop_toBottomOf="@id/purchasePriceTextView" />

                <TextView
                    android:id="@+id/baseLineTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="원  /"
                    android:textSize="25sp"
                    app:layout_constraintEnd_toStartOf="@id/purchasingVolumeEditText"
                    app:layout_constraintStart_toEndOf="@id/purchasePriceEditText"
                    app:layout_constraintTop_toTopOf="@id/purchasePriceEditText" />

                <EditText
                    android:id="@+id/purchasingVolumeEditText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:inputType="number"
                    app:layout_constraintEnd_toEndOf="@id/purchasingVolumeTextView"
                    app:layout_constraintStart_toEndOf="@id/baseLineTextView"
                    app:layout_constraintTop_toBottomOf="@id/purchasingVolumeTextView" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="개"
                    android:textSize="25sp"
                    app:layout_constraintStart_toEndOf="@id/purchasingVolumeEditText"
                    app:layout_constraintTop_toTopOf="@id/purchasePriceEditText" />

                <TextView
                    android:id="@+id/purchaseEditTextError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="빈칸을 입력해주세요."
                    android:textColor="#FD0000"
                    android:textSize="18sp"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="@id/purchasePriceTextView"
                    app:layout_constraintTop_toBottomOf="@id/purchasePriceEditText"
                    tools:visibility="visible" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/shareLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="22dp"
                android:background="@drawable/add_product_image_round"
                android:elevation="5dp"
                android:paddingBottom="18dp"
                app:layout_constraintTop_toBottomOf="@id/purchaseInfoLayout">

                <TextView
                    android:id="@+id/sharePriceTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:layout_marginTop="18dp"
                    android:fontFamily="@font/main_font"
                    android:text="공유 가격"
                    android:textColor="@color/app_main"
                    android:textSize="20sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/shareVolumeTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginEnd="50dp"
                    android:fontFamily="@font/main_font"
                    android:text="공유 수량"
                    android:textColor="@color/app_main"
                    android:textSize="20sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <EditText
                    android:id="@+id/sharePriceEditText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:inputType="number"
                    app:layout_constraintEnd_toStartOf="@id/shareBaseLineTextView"
                    app:layout_constraintStart_toStartOf="@id/sharePriceTextView"
                    app:layout_constraintTop_toBottomOf="@id/sharePriceTextView" />

                <TextView
                    android:id="@+id/shareBaseLineTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="원  /"
                    android:textSize="25sp"
                    app:layout_constraintEnd_toStartOf="@id/shareVolumeEditText"
                    app:layout_constraintStart_toEndOf="@id/sharePriceEditText"
                    app:layout_constraintTop_toTopOf="@id/sharePriceEditText" />

                <EditText
                    android:id="@+id/shareVolumeEditText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:inputType="number"
                    app:layout_constraintEnd_toEndOf="@id/shareVolumeTextView"
                    app:layout_constraintStart_toEndOf="@id/shareBaseLineTextView"
                    app:layout_constraintTop_toBottomOf="@id/shareVolumeTextView" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="개"
                    android:textSize="25sp"
                    app:layout_constraintStart_toEndOf="@id/shareVolumeEditText"
                    app:layout_constraintTop_toTopOf="@id/sharePriceEditText" />

                <TextView
                    android:id="@+id/shareEditTextError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="빈칸을 입력해주세요."
                    android:textColor="#FD0000"
                    android:textSize="18sp"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="@id/sharePriceTextView"
                    app:layout_constraintTop_toBottomOf="@id/sharePriceEditText"
                    tools:visibility="visible" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/buyDateLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="22dp"
                android:background="@drawable/add_product_image_round"
                android:elevation="5dp"
                app:layout_constraintTop_toBottomOf="@id/shareLayout">

                <TextView
                    android:id="@+id/buyDateTitleTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:layout_marginTop="18dp"
                    android:fontFamily="@font/main_font"
                    android:text="구매 일자"
                    android:textColor="@color/app_main"
                    android:textSize="20sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/buyDateTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="40dp"
                    android:background="@color/white"
                    android:elevation="10dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/buy_date"
                    android:textSize="30sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/buyDateTitleTextView" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/categoryLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="22dp"
                android:background="@drawable/add_product_image_round"
                android:elevation="5dp"
                app:layout_constraintTop_toBottomOf="@id/buyDateLayout">

                <TextView
                    android:id="@+id/categoryTitleTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:layout_marginTop="18dp"
                    android:fontFamily="@font/main_font"
                    android:text="카테고리"
                    android:textColor="@color/app_main"
                    android:textColorLink="@color/white"
                    android:textSize="20sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:layout_marginEnd="50dp"
                    android:layout_marginBottom="18dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/categoryTitleTextView">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip1"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="채소"
                            android:textSize="15sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:textEndPadding="15dp"
                            app:textStartPadding="15dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip2"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="과일"
                            android:textSize="15sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:textEndPadding="15dp"
                            app:textStartPadding="15dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip3"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="간편식"
                            android:textSize="15sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:textEndPadding="10dp"
                            app:textStartPadding="10dp" />


                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip4"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="정육"
                            android:textSize="15sp"
                            app:textEndPadding="15dp"
                            app:textStartPadding="15dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip5"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="수산물"
                            android:textSize="15sp"
                            app:textEndPadding="10dp"
                            app:textStartPadding="10dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip6"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="기타"
                            android:textSize="15sp"
                            app:textEndPadding="15dp"
                            app:textStartPadding="15dp" />

                    </androidx.constraintlayout.widget.ConstraintLayout>




                </com.google.android.material.chip.ChipGroup>

                <TextView
                    android:id="@+id/categoryError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="선택해주세요."
                    android:textColor="#FD0000"
                    android:textSize="18sp"
                    android:visibility="gone"
                    android:layout_marginTop="10dp"
                    app:layout_constraintStart_toStartOf="@id/categoryTitleTextView"
                    app:layout_constraintTop_toBottomOf="@id/chipGroup"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginBottom="10dp"
                    tools:visibility="visible" />


            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:id="@+id/bottomView"
                android:layout_width="match_parent"
                android:layout_height="?actionBarSize"
                app:layout_constraintBottom_toBottomOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/descriptionLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="22dp"
                android:background="@drawable/add_product_image_round"
                android:elevation="5dp"
                android:paddingBottom="10dp"
                app:layout_constraintTop_toBottomOf="@id/categoryLayout">


                <TextView
                    android:id="@+id/descriptionTitleTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:layout_marginTop="18dp"
                    android:fontFamily="@font/main_font"
                    android:text="상세 설명"
                    android:textColor="@color/app_main"
                    android:textSize="20sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/descriptionEditTextLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="35dp"
                    android:layout_marginEnd="28dp"
                    android:layout_marginBottom="18dp"
                    android:elevation="10dp"
                    app:counterEnabled="true"
                    app:counterMaxLength="80"
                    app:errorEnabled="true"
                    app:layout_constraintTop_toBottomOf="@id/descriptionTitleTextView">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/descriptionEditText"
                        android:layout_width="match_parent"
                        android:layout_height="250dp"
                        android:gravity="top"
                        android:hint="상품설명을 입력해주세요"
                        android:textSize="18sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/descriptionEditTextError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="빈칸을 입력해주세요."
                    android:textColor="#FD0000"
                    android:textSize="18sp"
                    android:visibility="gone"
                    android:layout_marginTop="10dp"
                    app:layout_constraintTop_toBottomOf="@id/descriptionEditTextLayout"
                    app:layout_constraintStart_toStartOf="@id/descriptionTitleTextView"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginBottom="10dp"
                    tools:visibility="visible" />


            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/placeLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="22dp"
                android:background="@drawable/add_product_image_round"
                android:elevation="5dp"
                app:layout_constraintTop_toBottomOf="@id/descriptionLayout">

                <TextView
                    android:id="@+id/placeTitleTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:layout_marginTop="18dp"
                    android:fontFamily="@font/main_font"
                    android:text="희망 공유 장소"
                    android:textColor="@color/app_main"
                    android:textSize="20sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/mapBigSizeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:background="@drawable/user_round"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:text="크게 보기"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    app:layout_constraintBottom_toTopOf="@id/map"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <fragment
                    android:id="@+id/map"
                    android:name="com.google.android.gms.maps.SupportMapFragment"
                    android:layout_width="0dp"
                    android:layout_height="256dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginBottom="30dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/placeTitleTextView"
                    tools:context=".AddProductsActivity" />


            </androidx.constraintlayout.widget.ConstraintLayout>

            <Button
                android:id="@+id/addProductNextButton"
                android:background="@drawable/product_next_button_round"
                app:layout_constraintTop_toBottomOf="@id/placeLayout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
