<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".domain.other_profile.OtherProfileActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bottom_round"
        android:elevation="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:src="@drawable/chat_room_back_image"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/menuButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="18dp"
            android:src="@drawable/setting_menu"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/backButton" />

        <LinearLayout
            android:id="@+id/nicknameLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/profileImageView"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="19dp"
            android:layout_marginStart="10dp">


            <TextView
                android:id="@+id/nicknameTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="딜리트딜리트님 가게"
                android:textColor="@color/app_main"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/introTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="소개글이 없습니다."
            android:textColor="@color/black"
            android:textSize="18sp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="18dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/profileImageView"
            app:layout_constraintTop_toBottomOf="@id/nicknameLayout"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageView
            android:id="@+id/profileImageView"
            android:layout_width="95dp"
            android:layout_height="95dp"
            android:layout_marginTop="32dp"
            android:src="@drawable/title_logo3"
            android:padding="1dp"
            android:background="@drawable/signup_profile_outline"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="28dp"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/goodCountLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/user_round"
            android:orientation="vertical"
            android:layout_marginBottom="-18dp"
            android:layout_marginStart="-18dp"
            app:layout_constraintBottom_toBottomOf="@id/profileImageView"
            app:layout_constraintStart_toStartOf="@id/profileImageView"
           >

            <TextView
                android:paddingTop="5dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/main_font"
                android:text="따봉"
                android:layout_gravity="center"
                android:textColor="@color/app_main"
                android:textSize="15sp" />

            <TextView
                android:paddingBottom="5dp"
                android:id="@+id/goodCountTextView"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/main_font"
                android:text="3.3"
                android:textColor="@color/black"
                android:textSize="15dp" />

        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/onSellLayout"
        android:layout_marginTop="18dp"
        android:padding="5dp"
        app:layout_constraintEnd_toStartOf="@id/soldOutLayout"
        app:layout_constraintTop_toBottomOf="@id/topLayout"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="wrap_content"
        android:backgroundTint="@color/app_main"
        android:background="@drawable/round_35"
        android:layout_height="wrap_content"
        android:elevation="10dp">

        <TextView
            android:textColor="@color/white"
            android:id="@+id/onSellTextView"
            android:padding="10dp"
            android:textSize="15sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="판매 중 999+"/>



    </LinearLayout>

    <LinearLayout
        android:padding="5dp"
        android:id="@+id/soldOutLayout"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toBottomOf="@id/topLayout"
        android:layout_width="wrap_content"
        android:background="@drawable/round_35"
        app:layout_constraintEnd_toStartOf="@id/reviewLayout"
        app:layout_constraintStart_toEndOf="@id/onSellLayout"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:elevation="10dp">

        <TextView
            android:id="@+id/soldOutTextView"
            android:padding="10dp"
            android:textSize="15sp"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="판매 완료 999+"/>

    </LinearLayout>

    <LinearLayout
        android:padding="5dp"
        android:id="@+id/reviewLayout"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toBottomOf="@id/topLayout"
        android:layout_width="wrap_content"
        android:background="@drawable/round_35"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        app:layout_constraintStart_toEndOf="@id/soldOutLayout"
        app:layout_constraintEnd_toEndOf="parent"
        android:elevation="10dp">

        <TextView
            android:id="@+id/reviewTextView"
            android:padding="10dp"
            android:textSize="15sp"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="후기 999+"/>

    </LinearLayout>




    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_other_profile_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/onSellLayout"
        android:layout_marginTop="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph_other_profile" />


</androidx.constraintlayout.widget.ConstraintLayout>