<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/productImageView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/app_main"
        app:layout_constraintDimensionRatio="H, 1.2:1"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
       android:layout_marginTop="-70dp"
        app:layout_constraintTop_toBottomOf="@id/productImageView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/round_top"
             >
            <ImageView
                android:id="@+id/profileImageView"
                android:layout_width="75dp"
                android:layout_height="75dp"
                android:layout_marginTop="20dp"
                android:layout_marginStart="20dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:src="@drawable/heart_fill"
                />

            <TextView
                android:id="@+id/userNicknameTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="내 이"
                android:textSize="20sp"
                android:textColor="@color/black"
                app:layout_constraintTop_toBottomOf="@id/profileImageView"
                app:layout_constraintStart_toStartOf="@id/profileImageView"
                app:layout_constraintEnd_toEndOf="@id/profileImageView"
                android:layout_marginTop="8dp"
                />

            <TextView
                android:layout_width="0dp"
                app:layout_constraintStart_toEndOf="@id/profileImageView"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/profileImageView"
                app:layout_constraintBottom_toBottomOf="@id/profileImageView"
                android:text="양파 10개 공유요!!"
                android:textSize="25sp"
                android:textColor="@color/black"
                android:gravity="center"
                android:textStyle="bold"
                android:layout_height="wrap_content"/>

            <View
                android:id="@+id/LineView"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#4D000000"
                app:layout_constraintTop_toBottomOf="@id/userNicknameTextView"
                android:layout_marginTop="10dp"
                />

            <ImageView
                android:id="@+id/likeImageView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/heart"
                app:layout_constraintTop_toBottomOf="@id/LineView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="18dp"
                />

            <TextView
                android:id="@+id/likeCountTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/likeImageView"
                android:text="0"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="@id/likeImageView"
                app:layout_constraintEnd_toEndOf="@id/likeImageView"
                android:layout_marginTop="2dp"
                />

            <TextView
                android:id="@+id/priceDateTitleTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="@id/likeImageView"
                app:layout_constraintStart_toStartOf="parent"
                android:text="구매일자"
                android:textSize="18sp"
                android:textColor="@color/app_main"
                android:fontFamily="@font/main_font"
                app:layout_constraintEnd_toStartOf="@id/likeImageView"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2023.09.12(화)"
                android:textSize="13sp"
                android:textColor="@color/black"
                app:layout_constraintStart_toStartOf="@id/priceDateTitleTextView"
                app:layout_constraintEnd_toEndOf="@id/priceDateTitleTextView"
                app:layout_constraintTop_toTopOf="@id/likeCountTextView"
                />
            <ImageView
                android:id="@+id/receiptImageView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="@id/likeImageView"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/likeImageView"
                app:layout_constraintBottom_toBottomOf="@id/likeImageView"
                android:src="@drawable/receipt"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="@id/receiptImageView"
                app:layout_constraintEnd_toEndOf="@id/receiptImageView"
                app:layout_constraintBottom_toBottomOf="@id/likeCountTextView"
                android:text="영수증"
                android:textSize="12sp"
                android:textColor="@color/black"
                />








        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>



</androidx.constraintlayout.widget.ConstraintLayout>