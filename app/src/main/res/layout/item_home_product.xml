<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="15dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:elevation="5dp"
        android:background="@drawable/home_product_shadow"
        app:layout_constraintBottom_toBottomOf="parent">


    <ImageView
        android:id="@+id/imageView"
        android:layout_width="195dp"
        android:layout_height="165dp"
        android:background="@drawable/home_product_round_15"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        android:src="@drawable/image_100"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="195dp"
        android:layout_height="80dp"
        android:background="@drawable/bottom_round_15"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imageView">

        <TextView
            android:id="@+id/titleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="18dp"
            android:text="양파 10개 공유요!!"
            android:textColor="@color/black"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/walkingDistanceTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:drawableStart="@drawable/point"
            android:layout_marginStart="10dp"
            android:drawablePadding="3dp"
            android:text="55"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#555555"
            android:textSize="14sp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@id/pickImageView"
            app:layout_constraintStart_toStartOf="@id/titleTextView"
            app:layout_constraintTop_toBottomOf="@id/titleTextView" />



        <ImageView
            android:id="@+id/pickImageView"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/heart"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/titleTextView" />

        <TextView
            android:id="@+id/heartScoreTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="27"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="@id/pickImageView"
            app:layout_constraintStart_toStartOf="@id/pickImageView"
            app:layout_constraintTop_toBottomOf="@id/pickImageView" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/priceView"
        android:layout_width="95dp"
        android:layout_height="32dp"
        android:background="@drawable/home_product_round"

        app:layout_constraintBottom_toBottomOf="@id/imageView"
        app:layout_constraintEnd_toEndOf="@id/imageView"
        app:layout_constraintTop_toBottomOf="@id/imageView">

        <TextView
            android:id="@+id/priceTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="개당 4000원"
            android:textColor="#FF0000" />
    </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>