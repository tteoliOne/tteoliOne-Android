<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/motionLayout"
    android:layout_width="match_parent"
    android:layout_height="136dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/deleteButton"
        android:layout_width="121dp"
        android:layout_height="106dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginBottom="15dp"
        android:background="@drawable/delete_round_30"
        android:gravity="center"
        android:text="삭제"
        android:textColor="@color/white"
        android:textSize="25sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="H, 1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/deleteButton"
        android:background="@drawable/delete_round_left_30"
        app:layout_constraintBottom_toBottomOf="@id/deleteButton"
        app:layout_constraintEnd_toStartOf="@id/deleteButton"
        app:layout_constraintStart_toStartOf="@id/productLayout"

        />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/productLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="15dp"
        android:background="@drawable/round_30"
        android:elevation="5dp"
        android:clickable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/imageView"
            android:layout_width="0dp"
            android:layout_height="106dp"
            android:scaleType="centerCrop"
            android:src="@drawable/image_100"
            app:layout_constraintBottom_toBottomOf="@id/productLayout"
            app:layout_constraintEnd_toStartOf="@id/textLayout"
            app:layout_constraintHorizontal_weight="4"
            app:layout_constraintStart_toStartOf="@+id/productLayout"
            app:layout_constraintTop_toTopOf="@+id/productLayout"
            app:riv_corner_radius_bottom_left="30dp"
            app:riv_corner_radius_top_left="30dp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/textLayout"
            android:layout_width="0dp"
            android:layout_height="106dp"
            app:layout_constraintBottom_toBottomOf="@+id/productLayout"
            app:layout_constraintEnd_toEndOf="@+id/productLayout"
            app:layout_constraintHorizontal_weight="6"
            app:layout_constraintStart_toEndOf="@id/imageView">

            <TextView
                android:id="@+id/titleTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="-8dp"
                android:text="양파 10개 공유해요!!"
                android:textColor="@color/black"
                android:textSize="16sp"
                app:layout_constraintBottom_toTopOf="@id/likeLayout"
                app:layout_constraintStart_toStartOf="@id/textLayout" />

            <ImageView
                android:id="@+id/walkingImageView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:src="@drawable/point"
                app:layout_constraintBottom_toBottomOf="@id/walkingTextView"
                app:layout_constraintStart_toStartOf="@id/textLayout"
                app:layout_constraintTop_toTopOf="@id/walkingTextView" />

            <TextView
                android:id="@+id/walkingTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="35m 도보 5분"
                android:textSize="14sp"
                app:layout_constraintBottom_toTopOf="@id/priceTextView"
                app:layout_constraintEnd_toStartOf="@id/likeLayout"
                app:layout_constraintStart_toEndOf="@id/walkingImageView"
                app:layout_constraintTop_toBottomOf="@id/titleTextView" />

            <TextView
                android:id="@+id/priceTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="28dp"
                android:layout_marginBottom="8dp"
                android:text="개당 4000원"
                android:textColor="#FF0000"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="@id/textLayout"
                app:layout_constraintEnd_toEndOf="@id/textLayout" />

            <LinearLayout
                android:id="@+id/likeLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="18dp"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/pickImageView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/heart" />

                <TextView
                    android:id="@+id/likeTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="14sp" />

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/soldOutBackground"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clickable="true"
            app:layout_constraintTop_toTopOf="@id/imageView"
            app:layout_constraintBottom_toBottomOf="@id/imageView"
            app:layout_constraintStart_toStartOf="@id/imageView"
            app:layout_constraintEnd_toEndOf="parent"
            android:backgroundTint="#4D000000"
            android:background="@drawable/round_30">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:text="거래완료"
                android:gravity="center"
                android:textSize="40sp"
                android:textColor="@color/white"
                android:fontFamily="@font/main_font"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>