<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/chatFragment"
        android:name="com.demo.sharingapp.domain.chat.ChatFragment"
        android:label="ChatFragment"
        tools:layout="@layout/fragment_chat"
        />

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.demo.sharingapp.domain.home.HomeFragment"
        android:label="HomeFragment"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_homePartProductFragment"
            app:destination="@id/homePartProductFragment" />
        <action
            android:id="@+id/action_homeFragment_to_selectProductFragment"
            app:destination="@id/selectProductFragment" />
        <action
            android:id="@+id/action_homeFragment_to_settingPlaceFragment"
            app:destination="@id/settingPlaceFragment" />
    </fragment>

    <fragment
        android:id="@+id/userFragment"
        android:name="com.demo.sharingapp.domain.user.UserFragment"
        android:label="UserFragment"
        tools:layout="@layout/fragment_user">
        <action
            android:id="@+id/action_userFragment_to_userSettingFragment"
            app:destination="@id/userSettingFragment"
            app:enterAnim="@anim/slide_in_up"
            app:exitAnim="@anim/slide_out_down"
            app:popEnterAnim="@anim/slide_pop_in_down"
            app:popExitAnim="@anim/slide_pop_out_up" />
        <action
            android:id="@+id/action_userFragment_to_settingMainFragment"
            app:destination="@id/settingMainFragment" />
    </fragment>

    <fragment
        android:id="@+id/settingMainFragment"
        android:name="com.demo.sharingapp.domain.user.setting.SettingMainFragment"
        android:label="SettingMainFragment"
        tools:layout="@layout/fragment_setting_main">

        <action
            android:id="@+id/action_settingMainFragment_to_settingProfileFragment"
            app:destination="@id/settingProfileFragment" />
        <action
            android:id="@+id/action_settingMainFragment_to_settingPlaceFragment"
            app:destination="@id/settingPlaceFragment" />
        <action
            android:id="@+id/action_settingMainFragment_to_settingPasswordFragment"
            app:destination="@id/settingPasswordFragment" />
    </fragment>

    <fragment
        android:id="@+id/settingProfileFragment"
        android:name="com.demo.sharingapp.domain.user.setting.account.SettingProfileFragment"
        android:label="SettingProfileFragment"
        tools:layout="@layout/fragment_setting_profile"/>

    <fragment
        android:id="@+id/userSettingFragment"
        android:name="com.demo.sharingapp.domain.user.UserSettingFragment"
        android:label="UserSettingFragment"
        tools:layout="@layout/fragment_user_setting">
        <argument
            android:name="nickname"
            app:argType="string" />
        <argument
            android:name="description"
            app:argType="string" />
        <argument
            android:name="profileImage"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/homePartProductFragment"
        android:name="com.demo.sharingapp.domain.home.HomePartProductFragment"
        android:label="HomePartProductFragment"
        tools:layout="@layout/fragment_home_part_product" >
        <argument
            android:name="name"
            app:argType="string" />
        <action
            android:id="@+id/action_homePartProductFragment_to_selectProductFragment"
            app:destination="@id/selectProductFragment" />
        <argument
            android:name="longitude"
            app:argType="string" />
        <argument
            android:name="latitude"
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/selectProductFragment"
        android:name="com.demo.sharingapp.domain.home.part.SelectProductFragment"
        android:label="SelectProductFragment"
        tools:layout="@layout/fragment_home_select_product"/>
    <fragment
        android:id="@+id/settingPlaceFragment"
        android:name="com.demo.sharingapp.domain.user.setting.account.SettingPlaceFragment"
        android:label="SettingPlaceFragment"
        tools:layout="@layout/activity_user_place"/>
    <fragment
        android:id="@+id/settingPasswordFragment"
        android:name="com.demo.sharingapp.domain.user.setting.account.SettingPasswordFragment"
        android:label="SettingPasswordFragment"
        tools:layout="@layout/fragment_setting_password"/>




</navigation>